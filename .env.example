# 复制为仓库根目录 .env，并设为仅 root 可读。不得提交真实值。
# Linux 服务器上的绝对仓库路径。
REPO_ROOT=/data/chaitin/chaitin-triage-agent

# agent-compose daemon 模型配置。
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
AGENT_COMPOSE_GUEST_IMAGE=chaitin/agent-compose-guest@sha256:1c18be6907ad7d0ad4f13d95aa89530615412c0a016a01a0f9548503112b2ee0

# agent-compose 项目级 OctoBus 连接。这些 token 只进入 daemon。
OCTOBUS_BASE_URL=http://octobus:9000
WAZUH_INGRESS_TOKEN=
TRIAGE_RUNNER_TOKEN=
SCRIPT_SERVICE_TOKEN=

# OctoBus 控制面与人工运维能力。每项使用不同的随机值。
OCTOBUS_ADMIN_TOKEN=
TRIAGE_OPS_TOKEN=

# SecurityOps instance。飞书地址必须是自定义机器人 webhook。
AGENT_WEBHOOK_TOKEN=
DECISION_TOKEN_SECRET=
FEISHU_WEBHOOK_URL=
FEISHU_WEBHOOK_SECRET=

# Wazuh。triage_reader 是仅可读取 wazuh-alerts-* 的 Indexer 账号。
WAZUH_INDEXER_ADMIN_PASSWORD=
WAZUH_KIBANASERVER_PASSWORD=
WAZUH_API_PASSWORD=
WAZUH_TRIAGE_READER_PASSWORD=
WAZUH_DASHBOARD_PORT=8443
WAZUH_TEST_EVENT_ENABLED=false
WAZUH_TEST_EVENT_INTERVAL_MS=300000

# 本机 UI，仅绑定 127.0.0.1。
AUTH_USERNAME=admin
AUTH_PASSWORD=
AUTH_SECRET=
AGENT_COMPOSE_UI_HTTP_PORT=7412

# GitHub 发布 webhook（与 agent-compose 的 Wazuh webhook 完全独立）。
GITHUB_WEBHOOK_SECRET=
GITHUB_REPOSITORY=owner/chaitin-triage-agent
RELEASE_DEPLOY_BRANCH=develop
RELEASE_WEBHOOK_BIND_ADDRESS=127.0.0.1
RELEASE_WEBHOOK_PORT=9080
