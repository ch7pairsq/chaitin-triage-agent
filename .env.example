# Copy to .env for deployment. All secret values stay in the root-only file.
#
# ---------------------------------------------------------------------------
# LLM provider（被 Stack 中 agent-compose daemon 的 entrypoint 读取并 export，
# 用于 Runtime LLM Facade 向 guest 沙箱注入 scoped token；真实 key 不进沙箱）。
# 下列三项必填，缺失时 daemon 启动 fail closed（exit 78）。
# ---------------------------------------------------------------------------
LLM_API_ENDPOINT=
LLM_API_KEY=
LLM_MODEL=
#
# OctoBus 能力总线（agent-compose octobus_servers 原生接入）：
# token 只保存在 daemon，不进入 guest 沙箱；需对下方两个 capset 均有访问权。
OCTOBUS_BASE_URL=http://127.0.0.1:8080
OCTOBUS_TOKEN=
#
# One Agent uses two least-privilege OctoBus capability sets; never reuse tokens.
# 以下为沙箱内确定性工作流经 Connect RPC 直连 OctoBus 所需的最小权限 capset token。
SECURITY_TRIAGE_OCTOBUS_BASE_URL=http://127.0.0.1:8080
SECURITY_TRIAGE_OCTOBUS_CAPSET_ID=security-triage
SECURITY_TRIAGE_OCTOBUS_INSTANCE_ID=chaitin-triage-capabilities
SECURITY_TRIAGE_OCTOBUS_FULL_SERVICE=triage.capabilities.v1.CapabilityService
SECURITY_TRIAGE_OCTOBUS_TOKEN=
SECURITY_TRIAGE_STATE_DB_PATH=/triage-state/security-triage-state.db
SECURITY_TRIAGE_THREAT_EVIDENCE_PATH=
# LLM：默认真实调用（考核要求），两条路径二选一：
#   A) 直连 provider：显式填以下三项，真实 Key 可以直接写 .env（600 root:root）；
#   B) Runtime LLM Facade：留空下列 BASE/MODEL/KEY，daemon 用上方 LLM_API_*
#      注入 scoped token 与 facade URL。
# 真实调用开关：留空或填 1/true/on = 真实调用；填 0/false/off = 走 DeterministicNarrator。
SECURITY_TRIAGE_LLM_REAL_CALL=
SECURITY_TRIAGE_LLM_API_BASE=
SECURITY_TRIAGE_LLM_MODEL=
SECURITY_TRIAGE_LLM_API_KEY=
SECURITY_TRIAGE_LLM_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# start by zhangyuqiao 
# malware（恶意样本研判）工作流：代码保留，但演示部署未启用——
# agent-compose.yml 不注册 triage/malware-analysis capset，也不注入以下任何
# MALWARE_TRIAGE_* 变量；统一 CLI 对 malware 入参显式拒绝（fail closed）。
# 后续如需启用，恢复 agent-compose.yml 中 malware 声明并填写以下变量即可。
# end 
# ---------------------------------------------------------------------------
MALWARE_TRIAGE_OCTOBUS_BASE_URL=http://127.0.0.1:8080
MALWARE_TRIAGE_OCTOBUS_CAPSET_ID=malware-analysis
MALWARE_TRIAGE_OCTOBUS_INSTANCE_ID=local-sandbox-adapter
MALWARE_TRIAGE_OCTOBUS_AUTH_TOKEN=
MALWARE_TRIAGE_STATE_DB_PATH=/triage-state/malware-triage-state.db
MALWARE_TRIAGE_SAMPLE_REGISTRY_PATH=
MALWARE_TRIAGE_RAG_CORPUS_PATH=
MALWARE_TRIAGE_RAG_TOP_K=3
MALWARE_TRIAGE_RAG_MIN_SCORE=0.18
MALWARE_TRIAGE_RAG_LLM_CONTEXT_ENABLED=false
# 同上：留空走 facade；本地直连时才填写 BASE_URL（本地测试亦可用 LLM_API_KEY）。
MALWARE_TRIAGE_LLM_BASE_URL=
MALWARE_TRIAGE_LLM_MODEL=
MALWARE_TRIAGE_LLM_TIMEOUT_MS=10000

WECOM_WEBHOOK_URL=
WECOM_TIMEOUT_MS=5000
