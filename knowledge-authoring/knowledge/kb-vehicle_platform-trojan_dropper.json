    "事件时间、主体、资产和动作可形成一致时间线"
  ],
  "counterexamples": [
    "签名安装器释放已登记组件",
    "经审批的远程运维工具",
    "合法代理或监控组件"
  ],
  "falsePositiveConditions": [
    "排除条件 signed-installer 未正确关联",
    "资产、主体或授权时间窗映射错误"
