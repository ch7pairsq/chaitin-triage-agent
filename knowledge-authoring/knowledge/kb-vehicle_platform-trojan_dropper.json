  "falseNegativeConditions": [
    "必需事实 domainId、data.payload_released、data.released_child_executed、data.parent_child_hash_link 任一缺采时只能补证",
    "攻击者将活动拆分到多个来源或时间窗口以低于单次阈值"
  ],
  "bypassPoints": [
    "围绕阈值边界分散 种植者木马Trojan-Dropper 行为",
    "使用可信账号、签名工具或合法协议隐藏恶意意图"
  ],
  "unusableFields": [
    {
      "field": "rule.level",
      "reason": "单一规则等级不能完成攻击定性"
