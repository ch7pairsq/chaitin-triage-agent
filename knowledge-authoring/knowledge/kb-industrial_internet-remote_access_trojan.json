    "requiredFacts": [
      "domainId",
      "data.interactive_remote_control",
      "data.remote_command_count",
      "data.authorization_valid"
    ],
    "confirmWhen": {
      "all": [
        {
          "predicateId": "domain-industrial-internet",
          "path": "domainId",
          "op": "equals",
          "value": "industrial_internet"
        },
        {
          "predicateId": "interactive-control",
          "path": "data.interactive_remote_control",
          "op": "equals",
          "value": true
        },
        {
          "predicateId": "remote-command",
          "path": "data.remote_command_count",
          "op": "gte",
          "value": 1
        }
      ],
      "any": [
        {
          "predicateId": "rat-unauthorized",
          "path": "data.authorization_valid",
          "op": "equals",
          "value": false
        }
      ],
      "minimumAny": 1
    },
    "excludeWhen": {
      "any": [
        {
          "predicateId": "approved-remote-ops",
          "path": "data.approved_remote_operations",
          "op": "equals",
          "value": true
        }
      ]
    },
