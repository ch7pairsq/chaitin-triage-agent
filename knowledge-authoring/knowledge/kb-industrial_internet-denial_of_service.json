  "executableRule": {
    "version": "1.0",
    "requiredFacts": [
      "domainId",
      "data.request_rate_per_second",
      "data.error_rate_percent",
      "data.service_degradation"
    ],
    "confirmWhen": {
      "all": [
        {
          "predicateId": "domain-industrial-internet",
          "path": "domainId",
          "op": "equals",
          "value": "industrial_internet"
        },
        {
          "predicateId": "request-rate",
          "path": "data.request_rate_per_second",
          "op": "gte",
          "value": 300
        },
        {
          "predicateId": "error-rate",
          "path": "data.error_rate_percent",
          "op": "gte",
          "value": 20
        }
      ],
      "any": [
        {
          "predicateId": "service-impact",
          "path": "data.service_degradation",
          "op": "equals",
          "value": true
        }
      ],
      "minimumAny": 1
    },
    "excludeWhen": {
      "any": [
        {
          "predicateId": "approved-load-test",
          "path": "data.approved_load_test",
          "op": "equals",
          "value": true
        }
      ]
    },
