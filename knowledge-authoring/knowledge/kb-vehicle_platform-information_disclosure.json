  "executableRule": {
    "version": "1.0",
    "requiredFacts": [
      "domainId",
      "data.sensitive_item_count",
      "data.recipient_authorized",
      "data.exposure_confirmed"
    ],
    "confirmWhen": {
      "all": [
        {
          "predicateId": "domain-vehicle-platform",
          "path": "domainId",
          "op": "equals",
          "value": "vehicle_platform"
        },
        {
          "predicateId": "sensitive-items",
          "path": "data.sensitive_item_count",
          "op": "gte",
          "value": 1
        },
        {
          "predicateId": "recipient-unauthorized",
          "path": "data.recipient_authorized",
          "op": "equals",
          "value": false
        }
      ],
      "any": [
        {
          "predicateId": "exposure-confirmed",
          "path": "data.exposure_confirmed",
          "op": "equals",
          "value": true
        }
      ],
      "minimumAny": 1
    },
    "excludeWhen": {
      "any": [
        {
          "predicateId": "approved-masked-export",
          "path": "data.approved_masked_export",
          "op": "equals",
          "value": true
        }
      ]
    },
    "thresholdBasis": {
      "sourceIds": [
        "src-repository-reviewed-rule-cases",
        "src-wazuh-rule-language",
        "src-unece-r155",
        "src-cwe"
      ],
      "statement": "至少一项敏感数据向无权主体实际暴露时确认；已审批且脱敏的导出排除。",
