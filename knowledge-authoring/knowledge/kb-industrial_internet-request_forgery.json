  "executableRule": {
    "version": "1.0",
    "requiredFacts": [
      "domainId",
      "data.target_scope",
      "data.requester_authorized",
      "data.forged_action_observed"
    ],
    "confirmWhen": {
      "all": [
        {
          "predicateId": "domain-industrial-internet",
          "path": "domainId",
          "op": "equals",
          "value": "industrial_internet"
        },
        {
          "predicateId": "protected-target",
          "path": "data.target_scope",
          "op": "in",
          "value": [
            "internal",
            "privileged"
          ]
        },
        {
          "predicateId": "requester-unauthorized",
          "path": "data.requester_authorized",
          "op": "equals",
          "value": false
        }
      ],
      "any": [
        {
          "predicateId": "outbound-or-action",
          "path": "data.forged_action_observed",
          "op": "equals",
          "value": true
        }
      ],
      "minimumAny": 1
    },
    "excludeWhen": {
      "any": [
        {
          "predicateId": "approved-callback",
          "path": "data.approved_callback",
          "op": "equals",
          "value": true
        }
      ]
    },
