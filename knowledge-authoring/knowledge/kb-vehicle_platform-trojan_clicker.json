    "代理日志、应用交互与进程审计"
  ],
  "evidenceRequired": [
    "进程网络请求、点击标识、前台交互和收益目标",
    "文件哈希与签名",
    "进程树、持久化和网络证据"
  ],
  "evidencePolicy": {
    "kind": "minimum_independent_evidence",
    "minimumIndependentEvidence": 2,
    "basis": "后台进程在无用户交互时产生至少二十次点击请求才确认；批准广告质量验证排除。",
    "statisticalThreshold": false,
    "calibrationRule": "部署后按已完成人工复核的 Wazuh 告警与工单滚动校准；校准前所有结果均保留人工确认。"
  },
  "supportingEvidence": [
    "至少两类相互独立证据支持广告木马Trojan-Clicker判断",
