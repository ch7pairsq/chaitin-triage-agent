  ],
  "counterexamples": [
    "经授权的广告质量验证产生受控点击",
    "经审批的远程运维工具",
    "合法代理或监控组件"
  ],
  "falsePositiveConditions": [
    "排除条件 approved-ad-validation 未正确关联",
    "资产、主体或授权时间窗映射错误"
  ],
  "falseNegativeConditions": [
    "必需事实 domainId、data.click_requests、data.user_interaction_present、data.background_process 任一缺采时只能补证",
    "攻击者将活动拆分到多个来源或时间窗口以低于单次阈值"
  ],
  "bypassPoints": [
    "围绕阈值边界分散 广告木马Trojan-Clicker 行为",
    "使用可信账号、签名工具或合法协议隐藏恶意意图"
  ],
  "unusableFields": [
    {
      "field": "rule.level",
      "reason": "单一规则等级不能完成攻击定性"
    },
    {
      "field": "source.ip",
      "reason": "单一来源地址不能证明主体或攻击意图"
    }
  ],
  "judgment": {
    "confirmed": "escalate_with_manual_review",
    "authorizedOrBenign": "suppress_with_manual_review",
    "insufficientEvidence": "request_additional_evidence",
    "unmatched": "manual_classification"
  },
  "recommendedAction": "记录研判结果，创建人工工单并发送飞书通知，等待人工确认后处置。",
  "policyStatus": "executable_operational_knowledge",
  "autoCloseAllowed": false,
  "ticketRequired": true,
  "knowledgeStatement": "在车联网平台安全中，广告木马Trojan-Clicker必须由告警、资产、身份或网络等多源证据共同支持；证据不足时不得自动定性或关闭。",
  "reviewFocus": "确认请求缺少真实用户交互并具有流量欺诈目的",
  "provenance": {
    "sourceClass": "internal_security_operations_experience",
    "sourceDescription": "内部安全运营经验整理"
