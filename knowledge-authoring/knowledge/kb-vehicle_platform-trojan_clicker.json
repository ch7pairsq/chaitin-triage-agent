  "reviewStatus": "approved",
  "reviewedBy": "zhangyuqiao",
  "reviewedAt": "2026-09-01T22:49:09.998Z",
  "reviewMarker": "Reviewed_Approved",
  "executableRule": {
    "version": "1.0",
    "requiredFacts": [
      "domainId",
      "data.click_requests",
      "data.user_interaction_present",
      "data.background_process"
    ],
    "confirmWhen": {
      "all": [
        {
          "predicateId": "domain-vehicle-platform",
          "path": "domainId",
          "op": "equals",
          "value": "vehicle_platform"
        },
        {
          "predicateId": "click-volume",
          "path": "data.click_requests",
          "op": "gte",
          "value": 20
        },
        {
          "predicateId": "no-user-interaction",
          "path": "data.user_interaction_present",
          "op": "equals",
          "value": false
        }
      ],
      "any": [
        {
          "predicateId": "background-clicker",
          "path": "data.background_process",
          "op": "equals",
          "value": true
        }
      ],
      "minimumAny": 1
    },
    "excludeWhen": {
      "any": [
        {
          "predicateId": "approved-ad-validation",
          "path": "data.approved_ad_validation",
          "op": "equals",
          "value": true
        }
      ]
    },
    "thresholdBasis": {
      "sourceIds": [
        "src-repository-reviewed-rule-cases",
        "src-wazuh-rule-language",
        "src-unece-r155",
        "src-mitre-attack-enterprise"
      ],
      "statement": "后台进程在无用户交互时产生至少二十次点击请求才确认；批准广告质量验证排除。",
