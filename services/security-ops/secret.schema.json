{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "security-ops 敏感配置",
  "type": "object",
  "required": ["agent_webhook_token", "feishu_webhook_url"],
  "properties": {
    "agent_webhook_token": {
      "type": "string",
      "minLength": 24
    },
    "feishu_webhook_url": {
      "type": "string",
      "format": "uri"
    },
    "feishu_webhook_secret": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false
}
