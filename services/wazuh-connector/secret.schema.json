{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexer_username", "indexer_password"],
  "properties": {
    "indexer_username": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "indexer_password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 512
    }
  }
}
